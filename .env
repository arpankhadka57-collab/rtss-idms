# =================================================================
# RELIABLETECH SERVICES & SUPPLIERS (RTSS) ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to '.env' in the project root:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTE:
# Never commit '.env' to git or share your App Passwords publicly.
# '.env' is automatically ignored in .gitignore.
# =================================================================

# GEMINI_API_KEY: Required for Help Desk AI Assistant features.
GEMINI_API_KEY=

# PORT: Default is 3000 (standard for local development and containers)
PORT=3000

# =================================================================
# GMAIL SMTP DISPATCH CONFIGURATION (FOR OTP & ORDER NOTIFICATIONS)
# =================================================================
# Instructions to generate a 16-character Google App Password:
# 1. Go to your Google Account (https://myaccount.google.com)
# 2. Enable 2-Step Verification under Security
# 3. Go to "App passwords" (https://myaccount.google.com/apppasswords)
# 4. Create an App name (e.g. "RTSS App") and copy the 16-character code
# 5. Paste the email and 16-character App Password below.
# Note: Spaces in the password will be automatically removed by the server.

# Priority 1 Email Dispatcher (Sends up to 400 emails daily)
EMAIL_USER_2=donotreply.rtss@gmail.com
EMAIL_APP_PASS_2=

# Priority 2 Email Dispatcher (Secondary Failover after 400 daily emails)
EMAIL_USER_1=reliabletechss.fikkal@gmail.com
EMAIL_APP_PASS_1=
